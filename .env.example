# Database
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5433/doc_intelligence

# LLM Configuration (NVIDIA NIM or OpenAI-compatible)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your_nvidia_or_openai_api_key_here
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Anthropic (Optional)
ANTHROPIC_API_KEY=

# Extraction & Confidence Thresholds
OCR_FLOOR_CONFIDENCE=0.3
CONFIDENCE_REVIEW_THRESHOLD=0.7
CONFIDENCE_WEIGHT_OCR=0.5
CONFIDENCE_WEIGHT_STRING_SIM=0.3
CONFIDENCE_WEIGHT_VALIDATION=0.2
